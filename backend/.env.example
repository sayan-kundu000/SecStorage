# Backend Environment Template
ENVIRONMENT=development
DEBUG=true
PORT=8000
SECRET_KEY=change-this-in-production-64-character-secret-key-string

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secstorage_db

JWT_SECRET=super-secret-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

STORAGE_PROVIDER=supabase
STORAGE_ENDPOINT_URL=https://your-project.supabase.co/storage/v1/s3
STORAGE_BUCKET_NAME=secstorage-objects
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key
STORAGE_REGION=us-east-1
