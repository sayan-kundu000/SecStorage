# ==============================================================================
# SecStorage Monorepo — Environment Variables Template
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Backend Server Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production

# CORS Allowed Origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL Database Credentials
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secstorage_db

# Security & JWT Token Parameters
JWT_SECRET=super-secret-jwt-signing-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase S3 Object Storage Credentials
STORAGE_PROVIDER=supabase
STORAGE_ENDPOINT_URL=https://your-project-id.supabase.co/storage/v1/s3
STORAGE_BUCKET_NAME=secstorage-objects
STORAGE_ACCESS_KEY_ID=your-supabase-s3-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
STORAGE_REGION=us-east-1

# Frontend Configuration (Exposed to browser build)
VITE_API_BASE_URL=http://localhost:8000/api/v1
