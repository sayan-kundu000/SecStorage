# SecStorage Frontend Environment Configuration (Client-Safe)
# NOTE: Do NOT place database credentials, JWT secrets, or cloud API keys here.
# All VITE_* variables are embedded in the client build and publicly inspectable.

# Backend FastAPI REST API base endpoint (e.g. Render backend URL or local dev server)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application metadata
VITE_APP_NAME=SecStorage
VITE_APP_ENV=development
